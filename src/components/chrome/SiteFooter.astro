---
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { offices } from "@/config/contact";
import { footerNavigation, legalNavigation, siteConfig } from "@/config/site";
import { socialIcon } from "@/lib/socials";

const { newsletter, legal } = siteConfig;
const live = newsletter.enabled && newsletter.action !== "";
const year = new Date().getFullYear();
---

<footer class="on-night bg-black!">
  <div class="shell grid gap-16 pt-20 pb-16 lg:grid-cols-12 lg:gap-10 lg:pt-28">
    <div class="lg:col-span-5">
      <p class="text-title">{newsletter.title}</p>
      <p class="mt-3 max-w-sm text-night-muted">{newsletter.description}</p>
      <form
        class="subscribe mt-8 flex max-w-md items-center"
        action={live ? newsletter.action : undefined}
        method={newsletter.method}
        aria-describedby={live ? undefined : "newsletter-note"}
      >
        <label for="footer-email" class="sr-only">Email address</label>
        <input
          id="footer-email"
          name={newsletter.emailFieldName}
          type="email"
          required
          autocomplete="email"
          placeholder="Email address"
          disabled={!live}
          class="h-12 min-w-0 flex-1 bg-transparent outline-none placeholder:text-night-muted disabled:cursor-not-allowed"
        />
        <button type="submit" class="flex h-12 items-center gap-2 pl-4 font-medium disabled:cursor-not-allowed disabled:opacity-50" disabled={!live}>
          Subscribe <Icon name="arrow-right" class="arrow" />
        </button>
      </form>
      {
        !live && (
          <p id="newsletter-note" class="label mt-3">
            Sign-up is off in this preview. Connect a form endpoint in the site config to turn it on.
          </p>
        )
      }
    </div>

    <nav class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:col-span-7" aria-label="Footer">
      {
        footerNavigation.map((column) => (
          <div>
            <p class="label">{column.title}</p>
            <ul class="mt-4 grid gap-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="link text-[0.9375rem]">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="shell">
    <ul class="grid gap-8 border-t border-night-line pt-10 pb-14 sm:grid-cols-3">
      {
        offices.map((office) => (
          <li class="text-[0.9375rem]">
            <p>{office.city}</p>
            <address class="mt-2 text-night-muted not-italic">
              {office.address.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="shell pb-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end">
      <a href="/" class="inline-flex" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-6" />
      </a>
      <ul class="flex items-center gap-1 sm:ml-auto">
        {
          siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="grid size-10 place-items-center text-night-muted transition-colors hover:text-night-ink" aria-label={social.label}>
                <Icon name={socialIcon(social.label)} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="label mt-8 grid gap-3 lg:grid-cols-12 lg:gap-10">
      <div class="grid gap-3 lg:col-span-4">
        <p>© {year} {siteConfig.legalName}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {
            legalNavigation.map((link) => (
              <li>
                <a href={link.href} class="link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {legal && <p class="max-w-2xl lg:col-span-8 lg:justify-self-end lg:text-right">{legal}</p>}
    </div>
  </div>
</footer>

<style>
  .subscribe {
    box-shadow: inset 0 -1px 0 rgb(243 243 241 / 0.3);
    transition: box-shadow 0.2s;
  }

  .subscribe:focus-within {
    box-shadow: inset 0 -1.5px 0 var(--night-ink);
  }
</style>
