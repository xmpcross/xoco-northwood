---
interface Props {
  title: string;
  rows: { label: string; count: number; href?: string }[];
}

const { title, rows } = Astro.props;
const largest = Math.max(1, ...rows.map((row) => row.count));
const total = rows.reduce((sum, row) => sum + row.count, 0);
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<figure class="reveal">
  <figcaption id={`breakdown-${slug}`} class="text-title">{title}</figcaption>
  <ul class="mt-8 grid gap-5" aria-labelledby={`breakdown-${slug}`}>
    {
      rows.map((row) => (
        <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2">
          {row.href ? (
            <a href={row.href} class="link-quiet">
              {row.label}
            </a>
          ) : (
            <span>{row.label}</span>
          )}
          <span class="label tabular">
            {row.count} <span class="sr-only">of {total}</span>
          </span>
          <span class="bar-track col-span-2" aria-hidden="true">
            <span class="bar" style={`--size:${(row.count / largest) * 100}%`} />
          </span>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .bar-track {
    display: block;
    height: 0.375rem;
    border-radius: 4px;
    background: var(--wash);
  }

  .bar {
    display: block;
    width: var(--size);
    height: 100%;
    border-radius: 4px;
    background: var(--blue);
  }
</style>
