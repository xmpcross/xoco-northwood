---
import EntryCard from "@/components/insights/EntryCard.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { home } from "@/config/home";
import { getInsights } from "@/lib/insights";
import { getTeam, teamById } from "@/lib/team";

const entries = (await getInsights()).slice(0, 3);
const team = teamById(await getTeam());
---

{
  entries.length > 0 && (
    <section class="section border-t border-line" aria-labelledby="journal-title">
      <div class="shell">
        <SectionHead id="journal-title" title={home.insights.title} link={home.insights.link} />
        <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
          {entries.map((entry, index) => (
            <div class:list={["reveal", index === 2 && "sm:max-lg:hidden"]} style={`--i:${index}`}>
              <EntryCard entry={entry} team={team} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
