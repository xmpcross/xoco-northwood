---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { categories, categoryKeys, type Category } from "@/config/insights";
import { categoryHref } from "@/lib/insights";

interface Props {
  title: string;
  lead: string;
  current?: Category;
}

const { title, lead, current } = Astro.props;
const links = [
  { label: "All", href: "/insights/", active: !current },
  ...categoryKeys.map((key) => ({ label: categories[key].label, href: categoryHref(key), active: key === current })),
];
---

<PageHeader title={title} lead={lead}>
  <div class="rise mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 border-b border-line lg:mt-20" style="--i:2">
    <nav aria-label="Categories" class="categories -mb-px min-w-0 max-w-full overflow-x-auto">
      <ul class="flex w-max gap-7">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="category block py-4 text-[0.9375rem] whitespace-nowrap" aria-current={link.active ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button type="button" class="label mb-4 inline-flex items-center gap-2.5 hover:text-ink sm:mb-0" data-search-open>
      <Icon name="search" class="size-4" />
      Search
      <kbd class="hidden bg-wash px-1.5 py-0.5 font-sans text-[0.6875rem] sm:inline">/</kbd>
    </button>
  </div>
</PageHeader>

<style>
  .categories {
    scrollbar-width: none;
  }

  .categories::-webkit-scrollbar {
    display: none;
  }

  .category {
    color: var(--muted);
    box-shadow: inset 0 -1px 0 transparent;
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }

  .category:hover {
    color: var(--ink);
  }

  .category[aria-current="page"] {
    color: var(--ink);
    box-shadow: inset 0 -1.5px 0 var(--ink);
  }
</style>
