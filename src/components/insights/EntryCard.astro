---
import { Image } from "astro:assets";
import { formatDate, joinNames } from "@/lib/format";
import { authorsOf, categoryLabel, entryHref, type Entry } from "@/lib/insights";
import type { Person } from "@/lib/team";

interface Props {
  entry: Entry;
  team: Map<string, Person>;
  variant?: "card" | "lead";
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}

const { entry, team, variant = "card", headingLevel = "h3", eager = false } = Astro.props;
const { title, description, cover, coverAlt, category, date, period } = entry.data;
const Heading = headingLevel;
const lead = variant === "lead";
const authors = joinNames(authorsOf(entry, team).map((person) => person.data.name));
---

<article class:list={["entry group relative flex h-full flex-col", lead && "gap-8 lg:grid lg:grid-cols-12 lg:items-end lg:gap-10"]}>
  <div class:list={["entry-face media relative", lead ? "aspect-3/2 lg:col-span-7" : "aspect-3/2"]}>
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          widths={lead ? [640, 960, 1400] : [480, 720, 960]}
          sizes={lead ? "(min-width: 1024px) 50rem, 100vw" : "(min-width: 1024px) 27rem, (min-width: 640px) 50vw, 100vw"}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager && lead ? "high" : undefined}
          class="entry-cover size-full object-cover"
        />
      ) : (
        <div class="letter-face on-night grain glow relative isolate flex size-full flex-col justify-between overflow-hidden p-6 sm:p-8" aria-hidden="true">
          <span class="label">{categoryLabel(category)}</span>
          <span class="entry-period text-[clamp(2.75rem,2rem+3vw,4.5rem)] leading-none tracking-[-0.03em] text-white/90">{period ?? date.getFullYear()}</span>
        </div>
      )
    }
  </div>
  <div class:list={["flex flex-1 flex-col", lead ? "lg:col-span-5 lg:pb-2" : "pt-5"]}>
    <p class="label">
      {categoryLabel(category)} <span aria-hidden="true">·</span> <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <Heading class:list={["mt-3", lead ? "text-display-md" : "text-title"]}>
      <a href={entryHref(entry)} class="link after:absolute after:inset-0">{title}</a>
    </Heading>
    <p class:list={["mt-3 text-muted", lead ? "text-lead" : "line-clamp-3"]}>{description}</p>
    {authors && <p class:list={["label mt-auto", lead ? "pt-8" : "pt-5"]}>{authors}</p>}
  </div>
</article>

<style>
  .entry-cover {
    transition: transform 1.2s var(--ease-out-expo);
  }

  .entry:hover .entry-cover {
    transform: scale(1.03);
  }

  .entry-period {
    transition: transform 0.8s var(--ease-out-expo);
  }

  .entry:hover .entry-period {
    transform: translateX(0.35rem);
  }

  .entry:has(a:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 6px;
  }

  .entry a:focus-visible {
    outline: none;
  }
</style>
