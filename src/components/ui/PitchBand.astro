---
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  text?: string;
}

const { title, text = "We read every pitch, and a partner replies within ten working days." } = Astro.props;
const { primary } = siteConfig.actions;
---

<section class="shell pb-[clamp(5rem,3.4rem+6vw,9rem)]" aria-label={primary.label}>
  <div class="band on-night grain glow reveal relative isolate overflow-hidden rounded-(--radius)">
    <div class="relative flex flex-col items-center px-6 py-20 text-center sm:py-28">
      <h2 class="max-w-[18ch] text-display-lg text-white/90">{title}</h2>
      <p class="mt-6 max-w-md text-white/65">{text}</p>
      <a href={primary.href} class="btn btn-light mt-10">
        {primary.label}
        <Icon name="arrow-right" class="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    --grain: 0.45;
    background: #2b2b2e;
  }

  /* A thin spectral edge along the top and bottom of the panel. */
  .band::before {
    inset: -40% -10%;
    height: auto;
    opacity: 0.9;
  }

  .band > div::before,
  .band > div::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ff9a5a 25%, #b06cff 50%, #5c8bff 75%, transparent);
    opacity: 0.8;
  }

  .band > div::before {
    top: 0;
  }

  .band > div::after {
    bottom: 0;
  }
</style>
