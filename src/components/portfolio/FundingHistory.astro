---
import { siteConfig } from "@/config/site";
import { formatMoney, formatMonth } from "@/lib/format";
import { totalRaised, type Company } from "@/lib/portfolio";

interface Props {
  company: Company;
}

const { company } = Astro.props;
const { rounds, exit } = company.data;
const total = totalRaised(company);
const exitLabel = exit && (exit.type === "IPO" ? `Listed${exit.by ? ` on ${exit.by}` : ""}` : `Acquired${exit.by ? ` by ${exit.by}` : ""}`);
---

{
  rounds.length > 0 && (
    <section class="mt-16" aria-labelledby="funding-title">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h2 id="funding-title" class="text-title">
          Funding history
        </h2>
        {total > 0 && (
          <p class="label tabular">
            {formatMoney(total)} raised across {rounds.length} {rounds.length === 1 ? "round" : "rounds"}
          </p>
        )}
      </div>
      <ol class="timeline mt-8">
        {rounds.map((round) => (
          <li class="step" data-northwood={round.northwood ? "" : undefined}>
            <p class="label tabular">
              <time datetime={round.date}>{formatMonth(round.date)}</time>
            </p>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="text-lg">
                {round.round}
                {round.amount !== undefined && <span class="text-muted tabular"> · {formatMoney(round.amount)}</span>}
              </p>
              {round.northwood && <p class="tag">{siteConfig.name} invested</p>}
            </div>
            {round.lead && <p class="label">Led by {round.lead}</p>}
          </li>
        ))}
        {exit && (
          <li class="step step-exit">
            <p class="label tabular">
              <time datetime={String(exit.year)}>{exit.year}</time>
            </p>
            <p class="text-lg">{exitLabel}</p>
          </li>
        )}
      </ol>
    </section>
  )
}

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-left: 1.75rem;
  }

  /* One rail down the left, with a marker per round. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.3125rem;
    width: 1px;
    background: var(--line-strong);
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.2rem;
  }

  .step::before {
    content: "";
    position: absolute;
    top: 0.2rem;
    left: -1.75rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--page);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }

  .step[data-northwood]::before {
    background: var(--green);
    box-shadow: 0 0 0 3px var(--page);
  }

  .step-exit::before {
    background: var(--ink);
    box-shadow: 0 0 0 3px var(--page);
  }

  .tag {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #e2f3e8;
    color: #15703c;
    font-size: 0.75rem;
    font-weight: 500;
  }
</style>
