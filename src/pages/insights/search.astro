---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/format";
import { categoryLabel, entryHref, getInsights } from "@/lib/insights";

const entries = await getInsights();
---

<BaseLayout title="Search insights" description="Search every essay, letter, playbook and news item." noindex>
  <section class="shell pt-16 pb-24 sm:pt-24 lg:pb-32">
    <h1 class="rise text-display-xl">Search</h1>
    <form class="rise mt-12 flex max-w-3xl items-center gap-4 border-b border-ink" role="search" action="/insights/search/" style="--i:1" data-search-page>
      <Icon name="search" class="size-5 text-muted" />
      <label for="search-page-input" class="sr-only">Search insights</label>
      <input
        id="search-page-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Essays, letters, companies, authors"
        class="h-16 min-w-0 flex-1 bg-transparent text-xl outline-none placeholder:text-faint"
      />
    </form>
    <p class="label mt-8" aria-live="polite" data-search-summary>{entries.length} entries</p>
    <ol class="mt-4 max-w-3xl" data-search-list>
      {
        entries.map((entry) => (
          <li data-href={entryHref(entry)} class="border-b border-line">
            <a href={entryHref(entry)} class="group block py-6">
              <span class="link text-title">{entry.data.title}</span>
              <span class="label mt-2 block">
                {categoryLabel(entry.data.category)} · {formatDate(entry.data.date)}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  import { rankEntries, type SearchItem } from "@/lib/search";

  const form = document.querySelector<HTMLFormElement>("[data-search-page]");
  const input = form?.querySelector("input");
  const list = document.querySelector<HTMLOListElement>("[data-search-list]");
  const summary = document.querySelector<HTMLElement>("[data-search-summary]");
  const rows = [...(list?.querySelectorAll<HTMLLIElement>("li") ?? [])];
  let index: SearchItem[] | null = null;

  const run = async () => {
    if (!input || !list || !summary) return;
    const query = input.value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!query) {
      rows.forEach((row) => (row.hidden = false));
      summary.textContent = `${rows.length} entries`;
      return;
    }
    index ??= await fetch("/search-index.json")
      .then((response) => response.json() as Promise<SearchItem[]>)
      .catch(() => []);
    const ranked = rankEntries(index, query).map((item) => item.href);
    rows.forEach((row) => (row.hidden = !ranked.includes(row.dataset.href ?? "")));
    ranked.forEach((href) => {
      const row = rows.find((item) => item.dataset.href === href);
      if (row) list.append(row);
    });
    summary.textContent = ranked.length
      ? `${ranked.length} result${ranked.length === 1 ? "" : "s"} for “${query}”`
      : `Nothing matches “${query}”.`;
  };

  if (input) {
    input.value = new URLSearchParams(window.location.search).get("q") ?? "";
    input.addEventListener("input", run);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      void run();
    });
    if (input.value) void run();
  }
</script>
