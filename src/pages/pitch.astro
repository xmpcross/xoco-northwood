---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { pitch } from "@/config/pitch";
import { sectorKeys, sectors } from "@/config/portfolio";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const live = siteConfig.pitch.enabled && siteConfig.pitch.action.trim() !== "";
const { criteria, process, form, faq } = pitch;
---

<BaseLayout title={pitch.title} description={pitch.lead}>
  <PageHeader title={pitch.title} lead={pitch.lead} />

  <div class="shell grid gap-20 pb-24 lg:grid-cols-12 lg:gap-10 lg:pb-32">
    <div class="grid content-start gap-20 lg:col-span-5">
      <section id="criteria" aria-labelledby="criteria-title">
        <h2 id="criteria-title" class="text-title">{criteria.title}</h2>
        <dl class="mt-8 grid gap-7">
          {
            criteria.items.map((item) => (
              <div class="reveal">
                <dt class="text-lg font-medium tracking-[-0.015em]">{item.title}</dt>
                <dd class="mt-1.5 text-muted">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="process-title">
        <h2 id="process-title" class="text-title">{process.title}</h2>
        <ol class="mt-8 grid gap-8">
          {
            process.steps.map((step, index) => (
              <li class="reveal grid grid-cols-[2.5rem_1fr] gap-x-4">
                <span class="text-title text-faint tabular">{index + 1}</span>
                <div>
                  <p class="text-lg font-medium tracking-[-0.015em]">{step.title}</p>
                  <p class="label mt-0.5 text-ink!">{step.timing}</p>
                  <p class="mt-2 text-muted">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <section class="lg:col-span-6 lg:col-start-7" aria-labelledby="form-title">
      <form
        class="grid gap-6 rounded-(--radius) bg-surface p-6 sm:p-10"
        action={live ? siteConfig.pitch.action : undefined}
        method={siteConfig.pitch.method}
        aria-describedby={live ? undefined : "pitch-note"}
      >
        <h2 id="form-title" class="text-title">{form.title}</h2>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="pitch-company" class="label text-ink!">Company name</label>
            <input id="pitch-company" name="company" type="text" autocomplete="organization" required class="field" />
          </div>
          <div class="grid gap-2">
            <label for="pitch-website" class="label text-ink!">Website <span class="text-muted">(optional)</span></label>
            <input id="pitch-website" name="website" type="url" inputmode="url" placeholder="https://" class="field" />
          </div>
          <div class="grid gap-2">
            <label for="pitch-name" class="label text-ink!">Your name</label>
            <input id="pitch-name" name="name" type="text" autocomplete="name" required class="field" />
          </div>
          <div class="grid gap-2">
            <label for="pitch-email" class="label text-ink!">Email</label>
            <input id="pitch-email" name="email" type="email" autocomplete="email" required class="field" />
          </div>
          <div class="grid gap-2">
            <label for="pitch-sector" class="label text-ink!">Sector</label>
            <select id="pitch-sector" name="sector" required class="field select">
              <option value="">Choose one</option>
              {sectorKeys.map((key) => <option value={key}>{sectors[key].label}</option>)}
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="grid gap-2">
            <label for="pitch-stage" class="label text-ink!">Stage</label>
            <select id="pitch-stage" name="stage" required class="field select">
              <option value="">Choose one</option>
              {form.stages.map((stage) => <option>{stage}</option>)}
            </select>
          </div>
          <div class="grid gap-2">
            <label for="pitch-location" class="label text-ink!">Where the team is based</label>
            <input id="pitch-location" name="location" type="text" autocomplete="address-level2" placeholder="City, country" required class="field" />
          </div>
          <div class="grid gap-2">
            <label for="pitch-raising" class="label text-ink!">Raising</label>
            <select id="pitch-raising" name="raising" class="field select">
              <option value="">Choose one</option>
              {form.raising.map((amount) => <option>{amount}</option>)}
            </select>
          </div>
        </div>

        <div class="grid gap-2">
          <label for="pitch-oneliner" class="label text-ink!">What you are building, in one sentence</label>
          <input id="pitch-oneliner" name="one_liner" type="text" maxlength="140" required class="field" aria-describedby="pitch-oneliner-hint" />
          <p id="pitch-oneliner-hint" class="label">140 characters at most.</p>
        </div>

        <div class="grid gap-2">
          <label for="pitch-why" class="label text-ink!">Why you, and why now?</label>
          <textarea id="pitch-why" name="why" rows="6" required class="field resize-y"></textarea>
        </div>

        <div class="grid gap-2">
          <label for="pitch-deck" class="label text-ink!">Link to a deck <span class="text-muted">(optional)</span></label>
          <input id="pitch-deck" name="deck" type="url" inputmode="url" placeholder="https://" class="field" />
        </div>

        <label class="flex items-start gap-3 text-[0.9375rem] text-ink-soft">
          <input type="checkbox" name="consent" required class="mt-1 size-4 shrink-0 accent-(--ink)" />
          {form.consent}
        </label>

        <div class="grid gap-4 pt-2 sm:flex sm:items-center sm:justify-between">
          <button type="submit" class="btn btn-primary justify-self-start disabled:cursor-not-allowed disabled:opacity-50" disabled={!live}>
            Send pitch
            <Icon name="arrow-right" class="arrow" />
          </button>
          {
            !live && (
              <p id="pitch-note" class="label sm:max-w-60 sm:text-right">
                The form is off in this preview. Connect a form endpoint in the site config to turn it on.
              </p>
            )
          }
        </div>
      </form>
    </section>
  </div>

  <section class="section border-t border-line" aria-labelledby="faq-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-10">
      <h2 id="faq-title" class="reveal text-display-md lg:col-span-4">{faq.title}</h2>
      <div class="lg:col-span-7 lg:col-start-6">
        {
          faq.items.map((item) => (
            <details class="faq group border-b border-line" name="faq">
              <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-lg">
                {item.question}
                <span class="faq-icon" aria-hidden="true" />
              </summary>
              <p class="max-w-2xl pb-7 text-muted">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq summary {
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }
</style>
