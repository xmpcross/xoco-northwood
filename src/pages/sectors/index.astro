---
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { sectorKeys, sectors, sectorsPage } from "@/config/portfolio";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCompanies, sectorHref, statusOf } from "@/lib/portfolio";

const companies = await getCompanies();
const cards = sectorKeys.map((key) => {
  const inSector = companies.filter((company) => company.data.sector === key);
  return {
    key,
    ...sectors[key],
    count: inSector.length,
    exits: inSector.filter((company) => statusOf(company) === "exited").length,
    logos: inSector.slice(0, 4),
  };
});
---

<BaseLayout title={sectorsPage.title} description={sectorsPage.lead}>
  <PageHeader title={sectorsPage.title} lead={sectorsPage.lead} />

  <section class="shell pb-24 lg:pb-32" aria-label="Sectors">
    <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card, index) => (
          <li class="reveal" style={`--i:${index % 3}`}>
            <a href={sectorHref(card.key)} class="sector group flex h-full flex-col rounded-(--radius) bg-surface p-6 sm:p-8">
              <span class="flex items-start justify-between gap-6">
                <span class="text-display-md">{card.label}</span>
                <Icon name="arrow-up-right" class="arrow arrow-out mt-2 text-muted" />
              </span>
              <span class="mt-4 text-muted">{card.description}</span>
              <span class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 text-[0.8rem]">
                {card.logos.map((company) => (
                  <CompanyLogo id={company.id} name={company.data.name} />
                ))}
              </span>
              <span class="label mt-auto pt-8 tabular">
                {card.count} {card.count === 1 ? "company" : "companies"}
                {card.exits > 0 && ` · ${card.exits} ${card.exits === 1 ? "exit" : "exits"}`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .sector {
    transition: background-color 0.3s;
  }

  .sector:hover {
    background: var(--wash);
  }
</style>
