---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { contact, offices } from "@/config/contact";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const live = siteConfig.contact.enabled && siteConfig.contact.action.trim() !== "";
---

<BaseLayout title={contact.title} description={contact.lead}>
  <PageHeader title={contact.title} lead={contact.lead} />

  <div class="shell grid gap-20 pb-24 lg:grid-cols-12 lg:gap-10 lg:pb-32">
    <section class="lg:col-span-5" aria-labelledby="inboxes-title">
      <h2 id="inboxes-title" class="sr-only">Inboxes</h2>
      <ul class="border-t border-ink">
        {
          contact.inboxes.map((inbox) => (
            <li class="reveal grid gap-1 border-b border-line py-6">
              <p class="text-title">{inbox.label}</p>
              <p class="text-muted">{inbox.detail}</p>
              <p class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
                <a href={`mailto:${inbox.email}`} class="link-quiet">
                  {inbox.email}
                </a>
                {inbox.href && (
                  <a href={inbox.href} class="group inline-flex items-center gap-1.5 font-medium">
                    <span class="link">Use the pitch form</span>
                    <Icon name="arrow-right" class="arrow size-3.5" />
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="lg:col-span-6 lg:col-start-7" aria-labelledby="message-title">
      <form
        class="grid gap-6 rounded-(--radius) bg-surface p-6 sm:p-10"
        action={live ? siteConfig.contact.action : undefined}
        method={siteConfig.contact.method}
        aria-describedby={live ? undefined : "contact-note"}
      >
        <h2 id="message-title" class="text-title">
          <label for="contact-topic">I’m writing about</label>
          <select id="contact-topic" name="topic" class="topic-select mt-2 block w-full cursor-pointer bg-transparent py-1 text-blue underline decoration-1 underline-offset-[0.2em] outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" data-contact-topic>
            {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
          </select>
        </h2>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="contact-name" class="label text-ink!">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required class="field" />
          </div>
          <div class="grid gap-2">
            <label for="contact-email" class="label text-ink!">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required class="field" />
          </div>
        </div>
        <div class="grid gap-2">
          <label for="contact-organisation" class="label text-ink!">Organisation <span class="text-muted">(optional)</span></label>
          <input id="contact-organisation" name="organisation" type="text" autocomplete="organization" class="field" />
        </div>
        <div class="grid gap-2">
          <label for="contact-message" class="label text-ink!">Message</label>
          <textarea id="contact-message" name="message" rows="6" required class="field resize-y"></textarea>
        </div>
        <div class="grid gap-4 pt-2 sm:flex sm:items-center sm:justify-between">
          <button type="submit" class="btn btn-primary justify-self-start disabled:cursor-not-allowed disabled:opacity-50" disabled={!live}>
            Send message
            <Icon name="arrow-right" class="arrow" />
          </button>
          {
            !live && (
              <p id="contact-note" class="label sm:max-w-60 sm:text-right">
                The form is off in this preview. Connect a form endpoint in the site config to turn it on.
              </p>
            )
          }
        </div>
      </form>
    </section>
  </div>

  <section class="section on-night grain relative isolate overflow-hidden" aria-labelledby="offices-title">
    <div class="shell">
      <h2 id="offices-title" class="reveal text-display-md">Offices</h2>
      <ul class="mt-12 grid gap-10 sm:grid-cols-3">
        {
          offices.map((office) => (
            <li class="reveal">
              <p class="text-title">{office.city}</p>
              <address class="mt-3 text-night-muted not-italic">
                {office.address.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </address>
              {office.phone && (
                <a href={`tel:${office.phone.replace(/\s/g, "")}`} class="link mt-3 inline-block tabular">
                  {office.phone}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-select {
    appearance: none;
    font: inherit;
    letter-spacing: inherit;
  }

  .topic-select option {
    color: var(--ink);
    font-size: 1rem;
  }
</style>

<script>
  const topic = new URLSearchParams(window.location.search).get("topic");
  const select = document.querySelector<HTMLSelectElement>("[data-contact-topic]");
  if (select && topic && [...select.options].some((option) => option.value === topic)) select.value = topic;
</script>
